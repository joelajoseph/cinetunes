<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Values are substituted from Config/Secrets.xcconfig at build time.
	  Keys not listed here are still generated by Xcode (see
	  GENERATE_INFOPLIST_FILE) and merged into the final bundle Info.plist.
	-->
	<key>SpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>
	<key>SpotifyClientSecret</key>
	<string>$(SPOTIFY_CLIENT_SECRET)</string>
	<key>TMDBAPIKey</key>
	<string>$(TMDB_API_KEY)</string>
</dict>
</plist>
