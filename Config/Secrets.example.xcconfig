// Copy this file to `Secrets.xcconfig` and fill in real values.
// `Secrets.xcconfig` is git-ignored and must never be committed.

// Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID = your_spotify_client_id
SPOTIFY_CLIENT_SECRET = your_spotify_client_secret

// TMDB API read access token (https://www.themoviedb.org/settings/api)
TMDB_API_KEY = your_tmdb_read_access_token
